# 复制为 .env 并填写真实值
# 厂商 API 密钥
DEEPSEEK_API_KEY=sk-xxxx
QWEN_API_KEY=sk-xxxx

# AES 主密钥（32 字节 base64，用于加密厂商密钥；生成：openssl rand -base64 32）
GATEWAY_MASTER_KEY=

# RabbitMQ 凭据
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# 审计落库 MySQL（gateway.audit.mysql-enabled=true 时）
MYSQL_ROOT_PASSWORD=lumina
AUDIT_MYSQL_URL=jdbc:mysql://mysql:3306/lumina
AUDIT_MYSQL_USER=root
AUDIT_MYSQL_PASSWORD=lumina

# 语义缓存 Embedding（SEMANTIC_ENABLED=true 时，复用 DeepSeek Key）
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL=deepseek-embed

# 功能开关（true/false）
AUDIT_MYSQL_ENABLED=false
SEMANTIC_ENABLED=false
VECTOR_BACKEND=memory
