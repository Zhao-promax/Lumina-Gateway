{
  "title": "Lumina Gateway 概览",
  "uid": "lumina-gateway",
  "panels": [
    {
      "type": "timeseries",
      "title": "请求量 QPS",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(gateway_requests_total[1m]))", "legendFormat": "QPS" }
      ]
    },
    {
      "type": "timeseries",
      "title": "P99 延迟 (秒)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "gateway_request_duration_seconds{quantile=\"0.99\"}", "legendFormat": "P99" },
        { "expr": "gateway_request_duration_seconds{quantile=\"0.95\"}", "legendFormat": "P95" },
        { "expr": "gateway_request_duration_seconds{quantile=\"0.5\"}", "legendFormat": "P50" }
      ]
    },
    {
      "type": "timeseries",
      "title": "错误率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(gateway_errors_total[1m]))", "legendFormat": "错误/秒" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token 消耗速率",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(rate(gateway_tokens_total[1m]))", "legendFormat": "tokens/秒" }
      ]
    },
    {
      "type": "stat",
      "title": "缓存命中率",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(gateway_cache_total{result=\"hit\"}[10m])) / clamp_min(sum(rate(gateway_cache_total[10m])), 1)", "legendFormat": "命中率" }
      ]
    },
    {
      "type": "stat",
      "title": "熔断触发次数",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(increase(gateway_circuitbreaker_opens_total[1h]))", "legendFormat": "熔断次数" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
